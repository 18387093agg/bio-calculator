import {
  CanonicalNutrient,
  NutrientCategory,
  ClinicalPathologyState,
  MealContextState,
} from '@/types/bioavailability';

export interface EntericAbsorptionResult {
  sanitizedChemicalForm: string;
  effectiveActiveRate: number;
  clinicalMechanismNotes: string[];
}

export interface CalorieAbsorptionProfile {
  proteinAbsorptionPct: number;
  fatAbsorptionPct: number;
  carbAbsorptionPct: number;
  netCalorieFactor: number;
  clinicalExplanation: string[];
}

export function evaluateCalorieMalabsorption(
  pathology: ClinicalPathologyState,
  isPureAnimalFood: boolean
): CalorieAbsorptionProfile {
  let proteinPct = 0.95;
  let fatPct = 0.97;
  let carbPct = 0.98;
  const explanation: string[] = [];

  // 1. Γαστρικό Οξύ & Πρωτεόλυση
  if (pathology.gastricAcid === 'hypochlorhydria') {
    proteinPct -= 0.10;
    explanation.push('Υποχλωρυδρία (pH > 3.0): Μειωμένη ενεργοποίηση πεψίνης (-10% διάσπαση πρωτεϊνών).');
  } else if (pathology.gastricAcid === 'achlorhydria') {
    proteinPct -= 0.20;
    explanation.push('Αχλωρυδρία: Πλήρης απουσία γαστρικού οξέος (-20% πρωτεϊνική αφομοίωση).');
  }

  // 2. SIBO & Χολικά Άλατα
  if (pathology.pathology === 'sibo') {
    fatPct -= 0.18;
    explanation.push('SIBO: Βακτηριακή αποσυζεύξη χολικών αλάτων (-18% απορρόφηση λιπιδίων / στεατόρροια).');
  }

  // 3. Crohn\'s / Celiac & Ατροφία Λαχνών
  if (pathology.pathology === 'crohns_celiac') {
    proteinPct -= 0.15;
    fatPct -= 0.15;
    carbPct -= 0.20;
    explanation.push('Ατροφία Λαχνών (Crohn/Celiac): Επιπέδωση επιθηλίου (-15% πρωτεΐνη, -15% λίπος, -20% υδατάνθρακες).');
  } else if (pathology.pathology === 'ileal_resection') {
    fatPct -= 0.30;
    explanation.push('Εκτομή Ειλεού: Απώλεια ανακυκλοφορίας χολικών αλάτων (-30% λιπιδική δυσαπορρόφηση).');
  }

  if (pathology.bileImpairment) {
    fatPct -= 0.12;
    explanation.push('Χολοκυστοπάθεια: Ατελής γαλακτωματοποίηση λιπιδίων (-12%).');
  }

  const netCalorieFactor = Number(((proteinPct + fatPct + carbPct) / 3).toFixed(2));

  return {
    proteinAbsorptionPct: Math.max(0.50, Number(proteinPct.toFixed(2))),
    fatAbsorptionPct: Math.max(0.40, Number(fatPct.toFixed(2))),
    carbAbsorptionPct: Math.max(0.50, Number(carbPct.toFixed(2))),
    netCalorieFactor,
    clinicalExplanation: explanation,
  };
}

export function evaluateEntericBioavailability(
  nutrient: CanonicalNutrient,
  chemicalForm: string,
  category: NutrientCategory,
  pathology: ClinicalPathologyState,
  context: MealContextState
): EntericAbsorptionResult {
  const notes: string[] = [];
  let baseRate = 0.50;
  let formName = chemicalForm || 'Standard Ionic Form';

  switch (nutrient) {
    case 'Vitamin A':
      if (context.isPureAnimalFood || formName.toLowerCase().includes('retin')) {
        baseRate = 0.85;
        formName = 'Preformed Retinyl Esters / Retinol';
      } else {
        baseRate = 0.25;
        formName = 'Beta-Carotene (Provitamin A)';
      }
      break;

    case 'Thiamine (B1)':
      baseRate = formName.toLowerCase().includes('ttfd') ? 0.90 : 0.35;
      break;

    case 'Iron':
      if (context.isPureAnimalFood || formName.toLowerCase().includes('heme')) {
        baseRate = 0.32;
        formName = 'Heme Iron (Fe2+ Porphyrin)';
      } else {
        baseRate = 0.10;
        formName = 'Non-Heme Iron (Fe3+/Fe2+)';
      }
      break;

    case 'Zinc':
      baseRate = context.isPureAnimalFood ? 0.45 : 0.28;
      break;

    case 'Copper':
      baseRate = 0.50;
      break;

    case 'Magnesium':
      baseRate = context.isPureAnimalFood ? 0.42 : 0.32;
      break;

    case 'Calcium':
      baseRate = 0.32;
      break;

    case 'Chromium':
      if (formName.toLowerCase().includes('picolinate')) {
        baseRate = 0.035;
        formName = 'Chromium Picolinate (Cr3+)';
      } else {
        baseRate = 0.012;
        formName = 'Inorganic Chromium (Trivalent)';
      }
      break;

    case 'Molybdenum':
      baseRate = 0.85;
      formName = formName.toLowerCase().includes('glycinate')
        ? 'Molybdenum Glycinate'
        : 'Dietary Molybdate / Molybdopterin';
      break;

    case 'Selenium':
      baseRate = 0.85;
      break;

    case 'Iodine':
      baseRate = 0.95;
      break;

    default:
      baseRate = 0.55;
      break;
  }

  // =========================================================================
  // ANTINUTRIENT INTERACTIONS
  // =========================================================================

  // Οξαλικά
  const oxalates = context.totalOxalatesMg || 0;
  if (oxalates > 50 && !context.isPureAnimalFood) {
    if (nutrient === 'Calcium') {
      const penalty = Math.min(0.70, (oxalates / 250) * 0.50);
      baseRate *= (1 - penalty);
      notes.push(`Οξαλικό Φορτίο (${oxalates}mg): Σχηματισμός αδιάλυτου οξαλικού ασβεστίου (-${Math.round(penalty * 100)}%).`);
    } else if (nutrient === 'Magnesium') {
      const penalty = Math.min(0.40, (oxalates / 300) * 0.30);
      baseRate *= (1 - penalty);
      notes.push(`Οξαλικό Φορτίο: Δέσμευση μέρους του διαλυτού μαγνησίου (-${Math.round(penalty * 100)}%).`);
    }
  }

  // Τανίνες / Πολυφαινόλες
  if (context.coingestedTannins) {
    if (nutrient === 'Iron' && !formName.toLowerCase().includes('heme')) {
      baseRate *= 0.35;
      notes.push('Τανίνες & Πολυφαινόλες (Καφές/Τσάι): Χηλικοποίηση Fe2+/Fe3+ στον αυλό (-65% βιοδιαθεσιμότητα).');
    }
    if (nutrient === 'Thiamine (B1)' && !formName.toLowerCase().includes('ttfd')) {
      baseRate *= 0.60;
      notes.push('Τανίνες: Μερική τροποποίηση ελεύθερης θειαμίνης σε ανενεργές μορφές (-40%).');
    }
  }

  // Φυτικά Οξέα (Phytates)
  const phytates = context.totalPhytatesMg || 0;
  if (phytates > 100 && !context.isPureAnimalFood) {
    if (nutrient === 'Zinc') {
      const penalty = Math.min(0.60, (phytates / 400) * 0.45);
      baseRate *= (1 - penalty);
      notes.push(`Φυτικά Οξέα (${phytates}mg): Σύμπλοκα φυτικού ψευδαργύρου (-${Math.round(penalty * 100)}%).`);
    } else if (nutrient === 'Iron' && !formName.toLowerCase().includes('heme')) {
      baseRate *= 0.50;
      notes.push('Φυτικά Οξέα: Αναστολή αναγωγής μη-αιμικού σιδήρου (-50%).');
    }
  }

  // DMT-1 Ανταγωνισμοί
  if (nutrient === 'Iron' && !formName.toLowerCase().includes('heme')) {
    if (context.totalCalciumMg > 350) {
      baseRate *= 0.65;
      notes.push('Ανταγωνισμός DMT-1: Υψηλό Ασβέστιο (>350mg) αναστέλλει τη μεταφορά μη-αιμικού σιδήρου.');
    }
    if (context.totalZincMg > 25) {
      baseRate *= 0.75;
      notes.push('Ανταγωνισμός DMT-1: Υψηλός Ψευδάργυρος (>25mg) δεσμεύει τους διαύλους δισθενών μετάλλων.');
    }
  }

  // Αναλογία Zn:Cu
  if (nutrient === 'Copper') {
    const znCuRatio = context.totalZincMg / (Math.max(0.1, context.totalCopperMg));
    if (znCuRatio > 20) {
      baseRate *= 0.40;
      notes.push(`⚠️ Ανισορροπία Zn:Cu (${znCuRatio.toFixed(1)}:1 > 20:1): Επαγωγή μεταλλοθειονίνης που εγκλωβίζει τον χαλκό.`);
    }
  }

  // Συνέργειες Βιταμίνης C
  if (context.totalVitaminCMg >= 50) {
    if (nutrient === 'Iron' && !formName.toLowerCase().includes('heme')) {
      baseRate *= 1.40;
      notes.push('Συνέργεια Βιταμίνης C: Αναγωγή Fe3+ σε Fe2+ για ευκολότερη πρόσληψη (+40%).');
    }
    if (nutrient === 'Chromium') {
      baseRate *= 1.30;
      notes.push('Συνέργεια Βιταμίνης C: Βελτίωση διαλυτότητας τρισθενούς χρωμίου (+30%).');
    }
  }

  // Παθολογία & Γαστρικό Οξύ
  if (pathology.gastricAcid === 'hypochlorhydria' || pathology.gastricAcid === 'achlorhydria') {
    if (nutrient === 'Iron' && !formName.toLowerCase().includes('heme')) {
      baseRate *= 0.40;
      notes.push('Υποχλωρυδρία: Αδυναμία αποσύνδεσης και ιονισμού του μη-αιμικού σιδήρου.');
    }
    if (nutrient === 'Calcium' && formName.toLowerCase().includes('carbonate')) {
      baseRate *= 0.25;
      notes.push('Υποχλωρυδρία: Το ανθρακικό ασβέστιο απαιτεί όξινο pH για να διαλυθεί.');
    }
    if (nutrient === 'Vitamin B12') {
      baseRate *= 0.30;
      notes.push('Υποχλωρυδρία: Μειωμένη έκκριση πεψίνης και ανεπαρκής απελευθέρωση της B12.');
    }
  }

  if (pathology.pathology === 'crohns_celiac') {
    baseRate *= 0.60;
    notes.push('Ατροφία Λαχνών (Celiac/Crohn): Μειωμένη επιφάνεια απορρόφησης.');
  }

  const effectiveActiveRate = Math.min(0.98, Math.max(0.01, Number(baseRate.toFixed(3))));

  return {
    sanitizedChemicalForm: formName,
    effectiveActiveRate,
    clinicalMechanismNotes: notes,
  };
}

