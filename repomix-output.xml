'use client';

import React, { useState } from 'react';

export interface DualRangeProgressBarProps {
  currentMin: number;             // Net Effective Usable Min
  currentMax: number;             // Net Effective Usable Max
  unit: string;
  rdaValue: number;
  optimalMin: number;
  optimalMax: number;
  upperTolerableLimit?: number;
  grossInput?: number;
  bioavailableMin?: number;
  bioavailableMax?: number;
  chemicalForm?: string;
  conversionRate?: number;
}

export function DualRangeProgressBar({
  currentMin,
  currentMax,
  unit,
  rdaValue,
  optimalMin,
  optimalMax,
  upperTolerableLimit,
  grossInput,
  bioavailableMin,
  bioavailableMax,
  chemicalForm,
  conversionRate = 1.0,
}: DualRangeProgressBarProps) {
  const [isHovered, setIsHovered] = useState(false);

  const safeOptMax = Math.max(optimalMax, 0.001);
  const hasRealUL = upperTolerableLimit !== undefined && upperTolerableLimit > safeOptMax;
  const effectiveUL = hasRealUL ? upperTolerableLimit! : Number((safeOptMax * 4).toFixed(1));

  // 0 -> 0%
  // OptMax -> 70%
  // UL (ή 4x Opt) -> 95%
  const calculatePercent = (val: number): number => {
    if (val <= 0) return 0;
    if (val <= safeOptMax) {
      return (val / safeOptMax) * 70;
    }
    if (val <= effectiveUL) {
      const span = Math.max(effectiveUL - safeOptMax, 0.001);
      return 70 + ((val - safeOptMax) / span) * 25;
    }
    const overflow = val - effectiveUL;
    return Math.min(100, 95 + (overflow / effectiveUL) * 5);
  };

  const minPct = calculatePercent(currentMin);
  const maxPct = calculatePercent(currentMax);
  const rdaPct = Math.max(3, Math.min(68, calculatePercent(rdaValue)));
  const optMinPct = Math.max(4, Math.min(69, calculatePercent(optimalMin)));
  const optMaxPct = 70; // ΣΤΑΘΕΡΑ ΣΤΟ 70%
  const ulPct = 95;     // ΣΤΑΘΕΡΑ ΣΤΟ 95%

  const isOptimal = currentMin >= optimalMin && (!hasRealUL || currentMax <= effectiveUL);
  const isExceedingUL = hasRealUL && currentMax > effectiveUL;
  const isRdaAndOptMinMerged = Math.abs(rdaPct - optMinPct) < 7;

  return (
    <div className="w-full font-mono space-y-2 pt-1 pb-2">
      {/* Header Info */}
      <div className="flex items-center justify-between text-xs pb-1">
        <span
          className={`px-2.5 py-0.5 rounded text-xs font-bold uppercase tracking-wider ${
            isExceedingUL
              ? 'bg-rose-950 text-rose-300 border border-rose-700 shadow-sm'
              : isOptimal
              ? 'bg-emerald-950 text-emerald-300 border border-emerald-700 shadow-sm'
              : 'bg-cyan-950 text-cyan-300 border border-cyan-800'
          }`}
        >
          {isExceedingUL ? '⚠️ Υπέρβαση UL' : isOptimal ? '✓ Βέλτιστο' : 'Υπο-βέλτιστο'}
        </span>

        <span className="text-slate-300 text-xs">
          Βέλτιστο Εύρος: <strong className="text-emerald-400 font-bold">{optimalMin} – {optimalMax} {unit}</strong>
        </span>
      </div>

      {/* Progress Track & Tooltip Wrapper */}
      <div
        className="relative group cursor-pointer"
        onMouseEnter={() => setIsHovered(true)}
        onMouseLeave={() => setIsHovered(false)}
      >
        <div className="relative h-5 w-full bg-slate-950 rounded-lg border border-slate-800 shadow-inner overflow-hidden">
          
          {/* OPTIMAL TARGET ZONE: Χωρίς χρώμα γεμίσματος για να μην μπερδεύεται ποτέ με την μπάρα */}
          <div
            style={{
              left: `${optMinPct}%`,
              width: `${Math.max(1, optMaxPct - optMinPct)}%`,
            }}
            className="absolute top-0 bottom-0 border-y border-dashed border-slate-700 pointer-events-none z-0"
          />

          {/* DUAL RANGE LEVEL 1: Solid Core (0 -> Min) */}
          <div
            style={{
              left: 0,
              width: `${Math.min(100, minPct)}%`,
            }}
            className={`h-full transition-all duration-300 z-10 absolute top-0 bottom-0 ${
              isExceedingUL
                ? 'bg-rose-600 shadow-[0_0_10px_rgba(225,29,72,0.8)]'
                : 'bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.7)]'
            }`}
          />

          {/* DUAL RANGE LEVEL 2: Opaque High End (Min -> Max) - ΧΩΡΙΣ ΚΑΘΕΤΗ ΓΡΑΜΜΗ ΣΤΟ ΤΕΛΟΣ */}
          <div
            style={{
              left: `${minPct}%`,
              width: `${Math.max(0, maxPct - minPct)}%`,
            }}
            className={`h-full transition-all duration-300 z-10 absolute top-0 bottom-0 ${
              isExceedingUL
                ? 'bg-rose-400/35'
                : 'bg-emerald-400/35'
            }`}
          />

          {/* HARD LINE: RDA (Bright White) */}
          <div
            style={{ left: `${rdaPct}%` }}
            className="absolute top-0 bottom-0 w-[2px] bg-slate-200 shadow-[0_0_6px_rgba(255,255,255,0.9)] z-20 pointer-events-none"
          />

          {/* HARD LINE: Opt Min (Bright Cyan) */}
          {!isRdaAndOptMinMerged && (
            <div
              style={{ left: `${optMinPct}%` }}
              className="absolute top-0 bottom-0 w-[2.5px] bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,1)] z-20 pointer-events-none"
            />
          )}

          {/* HARD LINE: Opt Max (Bright Emerald στο 70%) */}
          <div
            style={{ left: `${optMaxPct}%` }}
            className="absolute top-0 bottom-0 w-[3px] bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,1)] z-20 pointer-events-none"
          />

          {/* HARD LINE: UL / 4x Opt (Red στο 95%) */}
          <div
            style={{ left: `${ulPct}%` }}
            className={`absolute top-0 bottom-0 z-20 pointer-events-none ${
              hasRealUL
                ? 'w-[3px] bg-rose-500 shadow-[0_0_10px_rgba(244,63,94,1)]'
                : 'w-[2px] bg-slate-500 border-r border-dashed border-slate-400'
            }`}
          />
        </div>

        {/* 3-TIER CLINICAL TELEMETRY TOOLTIP */}
        {isHovered && (
          <div className="absolute -top-28 left-1/2 -translate-x-1/2 bg-slate-950 border border-slate-700 p-3 rounded-xl shadow-2xl z-50 text-[11px] font-mono w-80 space-y-1.5 pointer-events-none">
            <div className="flex justify-between border-b border-slate-800 pb-1">
              <span className="text-slate-400">Μορφή Συστατικού:</span>
              <span className="text-white font-bold truncate max-w-[160px]">{chemicalForm || 'Ενεργή Μορφή'}</span>
            </div>
            {grossInput !== undefined && (
              <div className="flex justify-between text-slate-300">
                <span className="text-slate-400">1. Gross στο Πιάτο:</span>
                <span>{grossInput.toFixed(1)} {unit}</span>
              </div>
            )}
            {bioavailableMin !== undefined && (
              <div className="flex justify-between text-cyan-300">
                <span className="text-slate-400">2. Εντερική Απορρόφηση:</span>
                <span>{bioavailableMin.toFixed(1)} – {bioavailableMax?.toFixed(1)} {unit}</span>
              </div>
            )}
            <div className="flex justify-between border-t border-slate-800/80 pt-1 text-emerald-400 font-bold">
              <span>3. Καθαρή Χρηστικότητα:</span>
              <span>{currentMin.toFixed(1)} – {currentMax.toFixed(1)} {unit}</span>
            </div>
            <div className="text-[10px] text-slate-500 text-right">
              Ενζυμική Απόδοση: {(conversionRate * 100).toFixed(0)}%
            </div>
          </div>
        )}
      </div>

      {/* Numerical Labels */}
      <div className="relative h-9 w-full text-xs font-semibold pt-1">
        <span className="absolute left-0 top-1 text-slate-500 text-xs">0</span>

        {isRdaAndOptMinMerged ? (
          <div
            style={{ left: `${rdaPct}%` }}
            className="absolute -translate-x-1/2 top-1 flex flex-col items-center whitespace-nowrap bg-slate-950/90 px-1.5 py-0.5 rounded border border-cyan-800"
          >
            <span className="text-cyan-300 font-bold text-xs">RDA / Opt Min</span>
