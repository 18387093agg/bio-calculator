        { food_name: 'Grass-Fed Ribeye Steak', preparation_method: 'Pan Fried / Tallow Seared', weight_grams: 450 },
        { food_name: 'Pastured Egg Yolk (Raw)', preparation_method: 'Raw', weight_grams: 80 },
