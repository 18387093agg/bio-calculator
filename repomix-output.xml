import {
  CanonicalNutrient,
  NutrientCategory,
} from '@/types/bioavailability';

export type CanonicalUnit = 'mg' | 'mcg';

export interface CanonicalizedMicro {
  canon: CanonicalNutrient;
  amountPer100g: number;
  unit: CanonicalUnit;
  category: NutrientCategory;
