import { CanonicalNutrient } from '@/types/bioavailability';

export interface BiomarkerInput {
  markerName: string;
  compartment: 'serum' | 'wbc_intracellular' | 'rbc_intracellular';
  value: number;
  unit: string; // ✅ Προστέθηκε το unit
  refLow: number;
  refHigh: number;
}

export interface BiomarkerClinicalVerdict {
  targetNutrient: CanonicalNutrient;
  status: 'deficient' | 'optimal' | 'excess' | 'unreliable_norm';
  dynamicTargetMultiplier: number;
  clinicalInsight: string;
}

export function evaluateBiomarkerStatus(
  marker: BiomarkerInput,
  contextMarkers: BiomarkerInput[]
): BiomarkerClinicalVerdict | null {
  const isLow = marker.value < marker.refLow;
  const isHigh = marker.value > marker.refHigh;

  // 1. ΣΙΔΗΡΟΣ / ΦΕΡΡΙΤΙΝΗ (Έλεγχος Φλεγμονής μέσω hs-CRP & TSAT)
  if (marker.markerName.toLowerCase().includes('ferritin')) {
    const hsCrp = contextMarkers.find((m) => m.markerName.toLowerCase().includes('crp'));
    const isInflamed = hsCrp && hsCrp.value > 3.0; // hs-CRP > 3 mg/L υποδηλώνει συστηματική φλεγμονή

    if (isHigh && isInflamed) {
      return {
        targetNutrient: 'Iron',
        status: 'unreliable_norm',
        dynamicTargetMultiplier: 1.0,
        clinicalInsight: `⚠️ Ψευδώς Αυξημένη Φερριτίνη (${marker.value} ${marker.unit}): Η hs-CRP (${hsCrp?.value} mg/L) δείχνει ενεργή φλεγμονή (Acute Phase Reactant). Δεν συνιστάται μείωση σιδήρου χωρίς επιβεβαίωση με TSAT%.`,
      };
    }

    if (isHigh && !isInflamed) {
      return {
        targetNutrient: 'Iron',
        status: 'excess',
        dynamicTargetMultiplier: 0.5,
        clinicalInsight: `Υπερφόρτωση Σιδήρου (Φερριτίνη ${marker.value} ${marker.unit} χωρίς φλεγμονή). Μείωση στόχου σιδήρου κατά 50% και αποφυγή εμπλουτισμένων πηγών.`,
      };
    }

    if (isLow) {
      return {
        targetNutrient: 'Iron',
        status: 'deficient',
        dynamicTargetMultiplier: 1.5,
        clinicalInsight: `Αποδεδειγμένη Έλλειψη Σιδήρου (Φερριτίνη ${marker.value} < ${marker.refLow} ${marker.unit}). Αύξηση στόχου σιδήρου κατά +50%.`,
      };
    }
  }

  // 2. ΥΔΑΤΟΔΙΑΛΥΤΑ & ΜΕΤΑΛΛΑ (Μαγνήσιο, Ψευδάργυρος, Χαλκός, Σελήνιο, B-Complex)
  const isMineralOrWaterSoluble = [
    'zinc', 'copper', 'magnesium', 'potassium', 'selenium', 
    'thiamine', 'b1', 'b2', 'b3', 'b6', 'b12', 'folate', 'b9', 
    'glutathione', 'carnitine', 'taurine'
  ].some((n) => marker.markerName.toLowerCase().includes(n));

  if (isMineralOrWaterSoluble) {
    const canonical = resolveCanonicalNutrient(marker.markerName);

    // ΑΣΥΜΜΕΤΡΟΣ ΚΑΝΟΝΑΣ ΟΡΟΥ (Serum)
    if (marker.compartment === 'serum') {
      if (isLow) {
        return {
          targetNutrient: canonical,
          status: 'deficient',
          dynamicTargetMultiplier: 1.4,
          clinicalInsight: `Σοβαρή Έλλειψη: Ακόμα και τα επίπεδα ορού (${marker.value} ${marker.unit}) έχουν καταρρεύσει κάτω από το φυσιολογικό. Τα κυτταρικά αποθέματα είναι εξαντλημένα (+40% στόχος).`,
        };
      } else {
        return {
          targetNutrient: canonical,
          status: 'unreliable_norm',
          dynamicTargetMultiplier: 1.0,
          clinicalInsight: `Ορός εντός ορίων (${marker.value} ${marker.unit}). Δεν αποτελεί απόδειξη ενδοκυττάριας επάρκειας. Απαιτείται μέτρηση WBC/RBC ή κλινική αξιολόγηση.`,
        };
      }
    }

    // ΕΝΔΟΚΥΤΤΑΡΙΟΣ ΕΛΕΓΧΟΣ (WBC / RBC Intracellular)
    if (marker.compartment === 'wbc_intracellular' || marker.compartment === 'rbc_intracellular') {
      if (isLow) {
        return {
          targetNutrient: canonical,
          status: 'deficient',
          dynamicTargetMultiplier: 1.5,
          clinicalInsight: `Κυτταρική Έλλειψη (${marker.compartment.toUpperCase()}: ${marker.value} < ${marker.refLow} ${marker.unit}). Τα ενδοκυττάρια ένζυμα υπολειτουργούν. Αύξηση στόχου κατά +50% με έμφαση σε χηλικές ή λιπόφιλες μορφές.`,
        };
      }
      if (isHigh) {
        return {
          targetNutrient: canonical,
          status: 'excess',
          dynamicTargetMultiplier: 0.8,
          clinicalInsight: `Υψηλά Ενδοκυττάρια Αποθέματα (${marker.value} ${marker.unit}). Πλήρης επάρκεια ιστών.`,
        };
      }
      return {
        targetNutrient: canonical,
        status: 'optimal',
        dynamicTargetMultiplier: 1.0,
        clinicalInsight: `Βέλτιστη Ενδοκυττάρια Συγκέντρωση (${marker.value} ${marker.unit}).`,
      };
    }
  }

  return null;
}

export function resolveCanonicalNutrient(rawName: string): CanonicalNutrient {
  const n = rawName.toLowerCase();
  if (n.includes('zinc')) return 'Zinc';
  if (n.includes('copper')) return 'Copper';
  if (n.includes('magnesium')) return 'Magnesium';
  if (n.includes('potassium')) return 'Potassium';
  if (n.includes('selenium')) return 'Selenium';
  if (n.includes('calcium')) return 'Calcium';
  if (n.includes('iron') || n.includes('ferritin')) return 'Iron';
  if (n.includes('thiamin') || n.includes('b1')) return 'Thiamine (B1)';
  if (n.includes('riboflavin') || n.includes('b2')) return 'Riboflavin (B2)';
  if (n.includes('niacin') || n.includes('b3')) return 'Niacin (B3)';
  if (n.includes('pantothen') || n.includes('b5')) return 'Pantothenic Acid (B5)';
  if (n.includes('pyridox') || n.includes('b6')) return 'Vitamin B6';
  if (n.includes('biotin') || n.includes('b7')) return 'Biotin (B7)';
  if (n.includes('folat') || n.includes('b9')) return 'Folate (B9)';
  if (n.includes('cobalamin') || n.includes('b12')) return 'Vitamin B12';
  if (n.includes('choline')) return 'Choline';
  if (n.includes('carnitine')) return 'Carnitine';
  if (n.includes('taurine')) return 'Taurine';
  return 'Zinc';
}

