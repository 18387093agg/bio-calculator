function getDefaultStaticMethods(): PreparationOption[] {
  return [
    { id: 'm1', method_name: 'Raw / Ωμό', retention_factor: 1.0 },
    { id: 'm2', method_name: 'Pan Fried / Tallow Seared', retention_factor: 0.88 },
