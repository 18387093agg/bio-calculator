function computeMealNutrientsDirect(
  items: MealItemInput[],
  isCarnivore: boolean,
  totalFatGrams: number
): MealBioactiveOutput[] {
  let grossVitA = 0;
  let grossVitD = 0;
  let grossVitE = 0;
  let grossVitK = 0;
  let grossVitC = 0;
  let grossB1 = 0;
  let grossB2 = 0;
  let grossB3 = 0;
  let grossB6 = 0;
  let grossB12 = 0;
  let grossFolate = 0;
  let grossCholine = 0;
  let grossCarnitine = 0;
  let grossTaurine = 0;
  let grossCalcium = 0;
  let grossMagnesium = 0;
  let grossPotassium = 0;
  let grossSodium = 0;
  let grossPhosphorus = 0;
  let grossZinc = 0;
  let grossCopper = 0;
  let grossIron = 0;
  let grossSelenium = 0;

  items.forEach((item) => {
    const g = Number(item.weight_grams) || 0;
    const n = (item.food_name || '').toLowerCase();

    if (n.includes('liver')) {
      grossVitA += g * 95.0;
      grossB12 += g * 0.70;
      grossCopper += g * 0.12;
      grossIron += g * 0.07;
      grossZinc += g * 0.05;
      grossB2 += g * 0.03;
      grossB3 += g * 0.15;
      grossB6 += g * 0.01;
      grossVitC += g * 0.15;
      grossCholine += g * 3.3;
      grossFolate += g * 2.9;
      grossSelenium += g * 0.40;
    } else if (n.includes('yolk')) {
      grossVitA += g * 4.0;
      grossVitD += g * 0.055;
      grossVitE += g * 0.035;
      grossVitK += g * 0.15;
      grossCholine += g * 8.2;
      grossSelenium += g * 0.55;
      grossIron += g * 0.027;
      grossZinc += g * 0.031;
      grossPhosphorus += g * 3.9;
      grossB2 += g * 0.005;
      grossB12 += g * 0.02;
    } else if (n.includes('marrow')) {
      grossCalcium += g * 0.5;
      grossPhosphorus += g * 1.2;
      grossIron += g * 0.045;
      grossVitK += g * 0.08;
    } else if (n.includes('almond')) {
      grossVitE += g * 0.26;
      grossMagnesium += g * 2.7;
      grossCalcium += g * 2.6;
      grossPotassium += g * 7.3;
      grossCopper += g * 0.01;
      grossZinc += g * 0.03;
      grossPhosphorus += g * 4.8;
      grossB2 += g * 0.01;
    } else {
      grossProteinBased(g, (k, v) => {
        if (k === 'zinc') grossZinc += v;
        if (k === 'iron') grossIron += v;
        if (k === 'potassium') grossPotassium += v;
        if (k === 'phosphorus') grossPhosphorus += v;
        if (k === 'b3') grossB3 += v;
        if (k === 'b6') grossB6 += v;
        if (k === 'b12') grossB12 += v;
        if (k === 'carnitine') grossCarnitine += v;
        if (k === 'taurine') grossTaurine += v;
      });
    }
  });

  const fatFactor = totalFatGrams >= 15 ? 0.80 : Math.max(0.20, totalFatGrams / 20);

  return [
    buildEntry('Vitamin A', isCarnivore ? 'Preformed Retinol / Retinyl Esters' : 'Carotenoids / Retinol Mix', 'fat_soluble_vitamin', 'mcg', grossVitA, grossVitA * (fatFactor - 0.05), grossVitA * fatFactor, 1500, totalFatGrams),
    buildEntry('Vitamin D', 'Cholecalciferol (D3)', 'fat_soluble_vitamin', 'mcg', grossVitD, grossVitD * 0.70, grossVitD * 0.85, 75, totalFatGrams),
    buildEntry('Vitamin E', 'Alpha-Tocopherol', 'fat_soluble_vitamin', 'mg', grossVitE, grossVitE * 0.50, grossVitE * 0.70, 20, totalFatGrams),
    buildEntry('Vitamin K', isCarnivore ? 'Menaquinone (MK-4)' : 'Phylloquinone (K1)', 'fat_soluble_vitamin', 'mcg', grossVitK, grossVitK * 0.65, grossVitK * 0.85, 200, totalFatGrams),
    buildEntry('Vitamin C', 'L-Ascorbic Acid', 'water_soluble_vitamin', 'mg', grossVitC, grossVitC * 0.75, grossVitC * 0.90, 90, totalFatGrams),
    buildEntry('Vitamin B6', 'Pyridoxal-5-Phosphate (P5P)', 'water_soluble_vitamin', 'mg', grossB6, grossB6 * 0.75, grossB6 * 0.88, 2.5, totalFatGrams),
    buildEntry('Vitamin B12', 'Methylcobalamin / Adenosylcobalamin', 'water_soluble_vitamin', 'mcg', grossB12, Math.min(2.5, grossB12 * 0.6), Math.min(3.0, grossB12 * 0.8), 5.0, totalFatGrams),
    buildEntry('Choline', 'Phosphatidylcholine / Sphingomyelin', 'vitamin_like', 'mg', grossCholine, grossCholine * 0.75, grossCholine * 0.85, 600, totalFatGrams),
    buildEntry('Carnitine', 'L-Carnitine (Free & Acylcarnitine)', 'amino_acid_derivative', 'mg', grossCarnitine, grossCarnitine * 0.60, grossCarnitine * 0.75, 100, totalFatGrams),
    buildEntry('Taurine', '2-Aminoethanesulfonic Acid', 'amino_acid_derivative', 'mg', grossTaurine, grossTaurine * 0.80, grossTaurine * 0.95, 100, totalFatGrams),
    buildEntry('Zinc', 'Zinc Glycinate / Protein-Bound', 'trace_mineral', 'mg', grossZinc, grossZinc * 0.40, grossZinc * 0.55, 15.0, totalFatGrams),
    buildEntry('Copper', 'Cuproprotein-Bound Copper', 'trace_mineral', 'mg', grossCopper, grossCopper * 0.45, grossCopper * 0.60, 2.0, totalFatGrams),
    buildEntry('Iron', isCarnivore ? 'Heme Iron (Fe2+ Porphyrin)' : 'Non-Heme / Mixed Iron', 'mineral', 'mg', grossIron, grossIron * 0.25, grossIron * 0.38, 18.0, totalFatGrams),
    buildEntry('Magnesium', 'Protein-Bound / Ionized Magnesium', 'mineral', 'mg', grossMagnesium, grossMagnesium * 0.35, grossMagnesium * 0.50, 450, totalFatGrams),
    buildEntry('Calcium', 'Calcium Ion (Protein/Phosphate Bound)', 'mineral', 'mg', grossCalcium, grossCalcium * 0.30, grossCalcium * 0.40, 1000, totalFatGrams),
    buildEntry('Potassium', 'Potassium Ion (K+)', 'electrolyte', 'mg', grossPotassium, grossPotassium * 0.85, grossPotassium * 0.95, 3800, totalFatGrams),
    buildEntry('Sodium', 'Sodium Ion (Na+)', 'electrolyte', 'mg', grossSodium, grossSodium * 0.90, grossSodium * 0.98, 2500, totalFatGrams),
    buildEntry('Selenium', 'Selenomethionine / Selenoprotein', 'trace_mineral', 'mcg', grossSelenium, grossSelenium * 0.80, grossSelenium * 0.90, 70, totalFatGrams),
  ];
}

function grossProteinBased(grams: number, add: (k: string, v: number) => void) {
  add('zinc', grams * 0.045);
  add('iron', grams * 0.025);
  add('potassium', grams * 3.5);
  add('phosphorus', grams * 2.0);
  add('b3', grams * 0.05);
  add('b6', grams * 0.005);
  add('b12', grams * 0.02);
  add('carnitine', grams * 0.6);
  add('taurine', grams * 0.4);
}

function buildEntry(
  name: string,
  form: string,
  category: any,
  unit: string,
  gross: number,
  netMin: number,
  netMax: number,
  target: number,
  totalFat: number
): MealBioactiveOutput {
  const g = Number(gross.toFixed(1));
  const min = Number(Math.max(0, netMin).toFixed(1));
  const max = Number(Math.max(min, netMax).toFixed(1));

  return {
    nutrient_name: name,
    chemical_form: form,
    nutrient_category: category,
    unit: unit,
    total_plate_gross: g,
    useful_net_min: min,
    useful_net_max: max,
    absorbed_min: min,
    absorbed_max: max,
    conversion_factor: 1.0,
    target_coverage_pct_min: Math.round((min / target) * 100),
    target_coverage_pct_max: Math.round((max / target) * 100),
    adjusted_daily_target: target,
    meal_matrix_status: 'calculated_active',
    total_fiber_grams: 0,
    total_fat_grams: totalFat,
    net_calorie_absorption_pct: 95,
  };
}

function sanitizeAndAggregateResults(
  rows: any[],
  isCarnivore: boolean,
  totalFatGrams: number
): MealBioactiveOutput[] {
  return rows.map((r) => ({
    nutrient_name: r.nutrient_name,
    chemical_form: r.chemical_form || 'Standard Species',
    nutrient_category: r.nutrient_category || 'other',
    unit: r.unit || 'mg',
    total_plate_gross: Number(r.total_plate_gross || 0),
    useful_net_min: Number(r.useful_net_min || 0),
    useful_net_max: Number(r.useful_net_max || 0),
    absorbed_min: Number(r.absorbed_min || r.useful_net_min || 0),
    absorbed_max: Number(r.absorbed_max || r.useful_net_max || 0),
    conversion_factor: 1.0,
    target_coverage_pct_min: Math.round((Number(r.useful_net_min || 0) / (r.adjusted_daily_target || 1)) * 100),
    target_coverage_pct_max: Math.round((Number(r.useful_net_max || 0) / (r.adjusted_daily_target || 1)) * 100),
    adjusted_daily_target: Number(r.adjusted_daily_target || 1),
    meal_matrix_status: 'optimal',
    total_fiber_grams: 0,
    total_fat_grams: totalFatGrams,
    net_calorie_absorption_pct: 95,
  }));
}

